# Optional: auto discovers a local CLI, then falls back to the bundled CLI.
RELAY_CODEX_COMMAND=auto

# Proxy variables must be exported by your shell or placed in .dsh-codex/.env.
# dsh intentionally refuses proxy overrides from the repository-level .env.

# Optional: register a workspace at startup without a native folder dialog.
# WORKBENCH_WORKSPACE=/absolute/path/to/your/project
